# SignalHound configuration. Copy to .env (git-ignored). NEVER commit real credentials.

# Go2 (laptop must be on the robot's WLAN; robot is 192.168.12.1 in LocalAP mode)
# ap = laptop on the robot's Wi-Fi; sta = robot joined a shared network (phone hotspot) -> set GO2_IP there or GO2_SERIAL
GO2_CONNECTION=ap
GO2_IP=192.168.12.1
GO2_SERIAL=
GO2_SSID=
GO2_WIFI_PASSWORD=
GO2_AES_KEY=

# Target beacon: BLE local name advertised by nRF Connect on the phone
TARGET_NAME=Galaxy S25

# serial = DK on USB; ble = DK rebroadcasts over BLE, laptop Bluetooth reads it (no cable, power bank on the dog)
RADIO_LINK=serial
# Nordic DK serial (auto-detects the SEGGER J-Link VCOM if empty)
NORDIC_SERIAL_PORT=
NORDIC_SERIAL_BAUD=115200

# RSSI filtering
RSSI_WINDOW=10
RSSI_MIN_SAMPLES=4
RSSI_EMA_ALPHA=0.4
# Samples needed before a decision (thin windows get one retry); baseline at/below this dBm = warning
DECISION_MIN_SAMPLES=3
WEAK_SIGNAL_DBM=-80
RSSI_STALE_SECONDS=6
# Max seconds to wait for RSSI_MIN_SAMPLES fresh packets after a move (slow beacons need more)
MEASURE_TIMEOUT_SECONDS=5

# Homing thresholds (dB). Tune from docs/experiment-log.md.
RSSI_IMPROVEMENT_DB=3
RSSI_WORSEN_DB=5
TARGET_RSSI_THRESHOLD=-52
# Near-target reflex: once best >= NEAR_DB, a drop of PASSED_DROP_DB below the best spot sends the dog back to it;
# it stops there if the level is within FOUND_AT_BEST_MARGIN_DB of the threshold (a held phone is body-shadowed).
NEAR_DB=-60
PASSED_DROP_DB=4
FOUND_AT_BEST_MARGIN_DB=3
MAX_RETURNS=3
TARGET_RSSI_HOLD_SECONDS=2
SETTLE_SECONDS=1.0
# Steps along a heading before judging it (with MOVE_STEP: ~1.8 m), and the 'getting warmer' margin
PROBE_PATIENCE=3
# When a heading is flat/worse: probe left for N steps, then right; commit to the better side (0 = blind turn)
SIDE_PROBE_STEPS=2
TREND_DB=1.5

# Motion bursts (hard caps: 0.5 m/s, 1.0 rad/s, 2 s per burst)
MOVE_SPEED=0.3
MOVE_STEP_SECONDS=2.0
ROTATE_SPEED=0.8
ROTATE_STEP_SECONDS=2.0

# Search limits
# scan = spin through N headings, face the strongest, drive K steps, repeat (needs a reflector behind the DK); climb = hill climbing
HOMING_MODE=climb
SCAN_HEADINGS=6
SCAN_GO_STEPS=3
SCAN_ABORT_DROP_DB=8
SEARCH_TIMEOUT_SECONDS=300
MAX_MOVES=60
OBSTACLE_STOP_M=0.6
