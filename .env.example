# Safe software demo defaults. Never silently fall back from dimos to mock.
# ROBOT_BACKEND: mock (simulated world) | webcam (stationary real camera) | dimos (Unitree Go2)
ROBOT_BACKEND=mock
DEMO_MODE=true
DATABASE_URL=sqlite:///data/recall.db

# Cloud agent (OpenAI Responses API tool calling). Leave empty for offline commands.
OPENAI_API_KEY=
OPENAI_MODEL=

# Robot limits enforced by recall_rover.robot.safety (and mirrored to dimOS --nerf-speed).
ROBOT_IP=
ROBOT_MAX_LINEAR_SPEED=0.25
ROBOT_MAX_ANGULAR_SPEED=0.4
NAVIGATION_TIMEOUT=30
# Planner speed 0.55 m/s x DIMOS_NERF_SPEED = cap. 0.45 -> ~0.25 m/s.
DIMOS_NERF_SPEED=0.45
DIMOS_TRANSPORT=zenoh
# Required for dimos backend: surveyed flat waypoints in the odometry frame. See config/zones.example.json
ZONES_FILE=

# Perception: mock | local (YOLO) | tags (ArUco) | combined (YOLO + ArUco)
PERCEPTION_PROVIDER=mock
PERCEPTION_DEVICE=cpu
DETECTOR_MODEL=yolo11n.pt
DETECTOR_LABELS=backpack,bottle,person,chair,laptop,handbag,suitcase,cup
CAMERA_SOURCE=0
PERCEPTION_INTERVAL=2
# Appearance association (HSV signature cosine similarity) thresholds.
APPEARANCE_MATCH_THRESHOLD=0.85
APPEARANCE_MATCH_MARGIN=0.05

# Optional voice
DEEPGRAM_API_KEY=
